# Copie para .env e preencha. Em produção, use Secret Manager do Cloud Run.
DJANGO_SECRET_KEY=troque-por-algo-longo-e-aleatorio
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Em produção (Cloud Run): DJANGO_CSRF_TRUSTED_ORIGINS=https://lean-ingles-xxxx.a.run.app

# Azure Speech (portal.azure.com -> Speech service -> Keys and Endpoint)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
# Use uma voz MULTILÍNGUE: o professor fala português com palavras em inglês e essas
# vozes trocam de idioma sozinhas. Boas opções:
#   en-US-AndrewMultilingualNeural  (masc., natural, meio sarcástico)  <- padrão
#   en-US-BrianMultilingualNeural   (masc., mais jovem)
#   en-US-AvaMultilingualNeural     (fem.)
#   pt-BR-ThalitaMultilingualNeural (fem., brasileira)
#   pt-BR-MacerioMultilingualNeural (masc., brasileiro)
# Vozes HD (muito mais naturais; sem visemas -> boca animada pelo volume):
#   en-US-Andrew:DragonHDLatestNeural      (masc., conversa natural)
#   en-US-Andrew2:DragonHDLatestNeural     (masc., ainda mais "papo")
#   en-US-Ava:DragonHDLatestNeural         (fem.)
#   pt-BR-Antonio:DragonHDOmniLatestNeural (masc. brasileiro, multilíngue, aceita estilos)
#   pt-BR-Francisca:DragonHDOmniLatestNeural (fem. brasileira, multilíngue)
#   en-US-Andrew:DragonHDOmniLatestNeural  (masc., multilíngue, aceita estilos)
# Teste todas em https://speech.microsoft.com/portal/voicegallery (filtro "HD")
# Base BRASILEIRA lê português certo; o inglês vem marcado pelo professor e é falado em en-US.
AZURE_TTS_VOICE=pt-BR-Antonio:DragonHDOmniLatestNeural
AZURE_TTS_VOICE_PT=pt-BR-MacerioMultilingualNeural

# Voz do professor: azure (boca sincronizada por fonema) ou openai (voz mais natural,
# aceita instrução de tom; boca animada pelo volume). Para openai, pegue a chave em
# https://platform.openai.com/api-keys (precisa de crédito, não tem tier gratuito).
TTS_PROVIDER=azure
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Vozes: ash (masc. grave), onyx (masc. profunda), echo, fable, ballad, verse, coral, nova, sage, shimmer
# Ouça em https://www.openai.fm
OPENAI_TTS_VOICE=ash
# Limite de espera de cada chamada OpenAI TTS, em segundos.
TTS_TIMEOUT_SECONDS=30
# Cache de áudio do professor por processo: 5 minutos, até 8 MiB e 64 entradas.
# TTL=0 desliga o cache. A voz e o idioma fazem parte da chave.
TTS_CACHE_TTL_SECONDS=300
TTS_CACHE_MAX_BYTES=8388608

# LLM (qualquer API compatível com OpenAI). Exemplos:
#   Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=openai/gpt-oss-120b  (ou llama-3.1-8b-instant; llama-3.3-70b é só Enterprise)
#   Together:   LLM_BASE_URL=https://api.together.xyz/v1      LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1     LLM_MODEL=meta-llama/llama-3.3-70b-instruct
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=30
# Evita multiplicar chamadas/espera em falhas de rede e rate limit.
LLM_MAX_RETRIES=0

# 1 = professor gentil, 2 = provocador, 3 = sem dó
TEACHER_SASS_LEVEL=2
